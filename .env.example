# The port number for the application to run on
PORT=<your_port_number>

# Local database name
DB_LOCAL_DBNAME=<your_database_name>

# Local database user
DB_LOCAL_USER=<your_database_user>

# Local database password
DB_LOCAL_PASSWORD=<your_database_password>

# Secret used to sign JWTs. Use a long, random value (e.g. `openssl rand -hex 32`).
JWT_SECRET=<your_long_random_secret>

# How long issued tokens stay valid (any value accepted by jsonwebtoken, e.g. 7d, 12h).
JWT_EXPIRY=7d
