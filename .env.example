# The port number for the application to run on
PORT=<your_port_number>

# Database connection. DB_HOST and DB_PORT default to 127.0.0.1 and 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_LOCAL_DBNAME=<your_database_name>
DB_LOCAL_USER=<your_database_user>
DB_LOCAL_PASSWORD=<your_database_password>
# TLS to the database (managed MySQL services): DB_SSL=true verifies the
# server certificate; DB_SSL_CA is the provider's CA file path or PEM text.
# DB_SSL=true
# DB_SSL_CA=/path/to/ca.pem
# Largest number of database connections per API instance (default 10).
# DB_POOL_MAX=10

# Separate, throwaway database for `npm test`. The tests wipe and re-seed it,
# so it must not be your development database.
DB_TEST_DBNAME=<your_test_database_name>

# Secret used to sign JWTs. At least 32 characters; the server won't start
# without it. Generate one with: openssl rand -hex 32
JWT_SECRET=<your_long_random_secret>

# How long issued tokens stay valid (any value accepted by jsonwebtoken, e.g. 7d, 12h).
JWT_EXPIRY=7d

# Frontend URL(s) allowed to call the API from a browser, comma-separated.
# Defaults to http://localhost:3000. Required when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000

# Set when running behind a proxy or load balancer (usually 1, the number of
# proxy hops) so rate limiting sees each client's real IP. Leave unset locally.
# TRUST_PROXY=1

# Email (verification and password-reset links), through any SMTP provider.
# Without SMTP_HOST, development prints emails to the log instead; production
# refuses to start without SMTP_HOST, MAIL_FROM and an https:// APP_URL.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false   # true for port 465; otherwise STARTTLS is required
# SMTP_REQUIRE_TLS=true   # false only for a local mail catcher without TLS
# SMTP_USER=<smtp user>
# SMTP_PASS=<smtp password>
# MAIL_FROM="Why Travel Alone <no-reply@example.com>"
# The frontend's address, used in links in emails. Defaults to http://localhost:3000.
# APP_URL=https://app.example.com

# Log detail: fatal, error, warn, info (default), debug, trace or silent.
# LOG_LEVEL=info

# Error reporting. Leave SENTRY_DSN unset to turn it off (the default).
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=<git sha or version>
