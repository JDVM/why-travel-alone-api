# The port number for the application to run on
PORT=<your_port_number>

# Database connection. DB_HOST and DB_PORT default to 127.0.0.1 and 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_LOCAL_DBNAME=<your_database_name>
DB_LOCAL_USER=<your_database_user>
DB_LOCAL_PASSWORD=<your_database_password>

# Separate, throwaway database for `npm test`. The tests wipe and re-seed it,
# so it must not be your development database.
DB_TEST_DBNAME=<your_test_database_name>

# Secret used to sign JWTs. At least 32 characters; the server won't start
# without it. Generate one with: openssl rand -hex 32
JWT_SECRET=<your_long_random_secret>

# How long issued tokens stay valid (any value accepted by jsonwebtoken, e.g. 7d, 12h).
JWT_EXPIRY=7d

# Frontend URL(s) allowed to call the API from a browser, comma-separated.
# Defaults to http://localhost:3000. Required when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000

# Set when running behind a proxy or load balancer (usually 1, the number of
# proxy hops) so rate limiting sees each client's real IP. Leave unset locally.
# TRUST_PROXY=1
